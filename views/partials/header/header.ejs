<!DOCTYPE html>
<html lang="en">

<meta http-equiv="content-type" content="text/html;charset=UTF-8" />

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        <%= typeof currentPage !== 'undefined' ? currentPage.metaTitle : settings.websitename %>
    </title>
    <meta name="description" content="<%= typeof currentPage !== 'undefined' ? currentPage.metaDescription : '' %>">

    <meta name="keywords" content="<%= typeof currentPage !== 'undefined' ? currentPage.metaKeywords : '' %>">
    <!-- favicons Icons -->
    <link rel="icon" type="image/png" href="<%= settings.websitefavicon.url %>" />

    <meta property="og:type" content="website">

    <meta property="og:url" content="<%= currentUrl %>">

    <!-- fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&amp;display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/webassets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/webassets/css/animate.min.css" />
    <link rel="stylesheet" href="/webassets/css/custom-animate.css" />
    <link rel="stylesheet" href="/webassets/css/swiper.min.css" />
    <link rel="stylesheet" href="/webassets/css/font-awesome-all.css" />
    <link rel="stylesheet" href="/webassets/css/jarallax.css" />
    <link rel="stylesheet" href="/webassets/css/jquery.magnific-popup.css" />
    <link rel="stylesheet" href="/webassets/css/flaticon.css">
    <link rel="stylesheet" href="/webassets/css/owl.carousel.min.css" />
    <link rel="stylesheet" href="/webassets/css/owl.theme.default.min.css" />
    <link rel="stylesheet" href="/webassets/css/nice-select.css" />
    <link rel="stylesheet" href="/webassets/css/jquery-ui.css" />
    <link rel="stylesheet" href="/webassets/css/aos.css" />
    <link rel="stylesheet" href="/webassets/css/odometer.min.css" />
    <link rel="stylesheet" href="/webassets/css/twentytwenty.css" />

    <!-- template styles -->
    <link rel="stylesheet" href="/webassets/css/style.css" />
    <link rel="stylesheet" href="/webassets/css/responsive.css" />

    <%- customCode?.headerCode || '' %>

        <% if(customCode?.cssCode){ %>
            <style>
                <%- customCode.cssCode %>
            </style>
            <% } %>


</head>

<body class="custom-cursor">
    <%- include('../flash.ejs') %>
        <div class="custom-cursor__cursor"></div>
        <div class="custom-cursor__cursor-two"></div>

        <!-- Start sidebar widget content -->
        <div class="xs-sidebar-group info-group info-sidebar">
            <div class="xs-overlay xs-bg-black"></div>
            <div class="xs-sidebar-widget">
                <div class="sidebar-widget-container">
                    <div class="widget-heading">
                        <a href="#" class="close-side-widget">X</a>
                    </div>
                    <div class="sidebar-textwidget">
                        <div class="sidebar-info-contents">
                            <div class="content-inner">
                                <div class="logo">
                                    <a href="/"><img src="<%= settings.websitewhitelogo.url %>" alt="" /></a>
                                </div>
                                <div class="content-box">
                                    <h4>About Us</h4>
                                    <div class="inner-text">
                                        <p>
                                            <%= settings.sidebarabouttext %>
                                        </p>
                                    </div>
                                </div>

                                <div class="form-inner">
                                    <h4>Get a free quote</h4>
                                    <form action="#" method="POST" class="contact-form-validated">
                                        <div class="form-group">
                                            <input type="text" name="name" placeholder="Name" required="">
                                        </div>
                                        <div class="form-group">
                                            <input type="email" name="email" placeholder="Email" required="">
                                        </div>
                                        <div class="form-group">
                                            <input type="tel" name="phone number" placeholder="Phone Number"
                                                required="">
                                        </div>
                                        <div class="form-group">
                                            <textarea name="message" placeholder="Message..." required=""></textarea>
                                        </div>
                                        <div class="form-group message-btn">
                                            <button class="thm-btn" data-text="Submit Now +" type="submit"
                                                data-loading-text="Please wait...">Submit Now
                                                <span class="icon-next"></span>
                                            </button>
                                        </div>
                                        <div class="result"></div>
                                    </form>
                                </div>
                                <div class="sidebar-contact-info">
                                    <h4>Contact Info</h4>
                                    <ul class="list-unstyled">
                                        <li>
                                            <span class="icon-pin"></span>
                                            <%= settings.address %>
                                        </li>
                                        <li>
                                            <span class="icon-phone-call"></span>
                                            <a href="tel:<%=  settings.phonenumber %>">
                                                <%= settings.phonenumber %>
                                            </a>
                                        </li>
                                        <li>
                                            <span class="icon-email"></span>
                                            <a href="mailto:<%= settings.email %>">
                                                <%= settings.email %>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                                <div class="thm-social-link1">
                                    <ul class="social-box list-unstyled">
                                        <li>
                                            <a href="<%= settings.facebook %>"><i class="fab fa-facebook-f"
                                                    aria-hidden="true"></i></a>
                                        </li>
                                        <li>
                                            <a href="<%= settings.twitter %>"><i class="fab fa-twitter"
                                                    aria-hidden="true"></i></a>
                                        </li>
                                        <li>
                                            <a href="<%= settings.linkedin %>"><i class="fab fa-linkedin"
                                                    aria-hidden="true"></i></a>
                                        </li>
                                        <li>
                                            <a href="<%= settings.instagram %>"><i class="fab fa-instagram"
                                                    aria-hidden="true"></i></a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>