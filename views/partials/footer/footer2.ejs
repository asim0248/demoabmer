<!--CTA One Start-->
<section class="cta-one cta-three">
    <div class="container">
        <div class="cta-one__inner wow fadeInUp" data-wow-duration=".9s" data-wow-delay="300ms">
            <div class="cta-one__inner-bg"
                style="background-image: url(assets/images/backgrounds/cta-one-inner-bg.jpg);"></div>
            <h3 class="cta-one__title">Subscribe for Any Update
                <br> Information
            </h3>
            <div class="cta-one__from-box">
                <form class="cta-one__form" action="/newsletter" method="POST">
                    <div class="cta-one__input-box">
                        <input type="hidden" name="redirectUrl" value="<%= currentUrl %>">
                        <input type="email" placeholder="Enter Email Address" name="email">
                        <button type="submit" class="thm-btn">Subscribe Us<span class="icon-next"></span></button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
<!--CTA One End-->

