<!--Site Footer Two Start-->
<footer class="site-footer-two">
    <div class="site-footer-two__shape-1 float-bob-x">
        <img src="/webassets/images/shapes/site-footer-two-shape-1.png" alt="">
    </div>
    <div class="container">
        <div class="site-footer-two__top">
            <div class="row">
                <div class="col-xl-4 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="100ms">
                    <div class="footer-widget-two__column footer-widget-two__about">
                        <div class="footer-widget-two__logo">
                            <a href="/"><img src="<%=  settings.websitewhitelogo.url %>" alt="logo"></a>
                        </div>
                        <p class="footer-widget-two__about-text">
                            <%= settings.footerabouttext %>
                        </p>
                        <ul class="footer-widget-two__contact list-unstyled">
                            <li>
                                <div class="icon">
                                    <span class="icon-phone-call"></span>
                                </div>
                                <div class="content">
                                    <h5>Contact</h5>
                                    <p><a href="tel:<%=  settings.phonenumber %>">
                                            <%= settings.phonenumber %>
                                        </a></p>
                                </div>
                            </li>
                            <li>
                                <div class="icon">
                                    <span class="icon-location"></span>
                                </div>
                                <div class="content">
                                    <h5>Location</h5>
                                    <p>
                                        <%= settings.address %>
                                    </p>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="col-xl-2 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="200ms">
                    <div class="footer-widget-two__column footer-widget-two__usefull-link">
                        <div class="footer-widget-two__title-box">
                            <h3 class="footer-widget-two__title">Quick Links</h3>
                        </div>
                        <div class="footer-widget-two__link-box">
                            <ul class="footer-widget-two__link list-unstyled">
                                <% footerPages.forEach(footpage=> { %>
                                    <% if (!footerPages) { %>
                                        <li>
                                            <p>footer pages not found.</p>
                                        </li>
                                        <% } else { %>
                                            <li><a href="<%= footpage.slug %>">
                                                    <%= footpage.pageName %>
                                                </a>
                                            </li>
                                            <% } %>
                                                <% }) %>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="300ms">
                    <div class="footer-widget-two__column footer-widget-two__services">
                        <div class="footer-widget-two__title-box">
                            <h3 class="footer-widget-two__title">Our Services</h3>
                        </div>
                        <ul class="footer-widget-two__link list-unstyled">
                            <% headerServices.forEach(footservice=> { %>
                                <% if (!headerServices) { %>
                                    <li>
                                        <p>footer pages not found.</p>
                                    </li>
                                    <% } else { %>
                                        <li><a href="/services/<%= footservice.slug %>">
                                                <%= footservice.title %>
                                            </a>
                                        </li>
                                        <% } %>
                                            <% }) %>
                        </ul>
                    </div>
                </div>
                <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInUp" data-wow-delay="400ms">
                    <div class="footer-widget-two__column footer-widget-two__newsletter">
                        <h3 class="footer-widget-two__newsletter-title">Subscribe To Our Newsletter To Get
                            Latest Update</h3>
                        <form action="/newsletter" method="POST" class="footer-widget-two__newsletter-form">
                            <div class="footer-widget-two__newsletter-form-input-box">
                                <input type="hidden" name="redirectUrl" value="<%= currentUrl %>">
                                <input type="email" placeholder="Enter email address..." name="email" required>
                                <button type="submit" class="footer-widget-two__newsletter-btn"><span
                                        class="fas fa-paper-plane"></span></button>
                            </div>
                            <div class="result"></div>
                        </form>
                        <div class="site-footer-two__social">
                            <a href="<%=  settings.facebook %>"><i class="icon-facebook-app-symbol"></i></a>
                            <a href="<%=  settings.twitter %>"><i class="icon-twitter"></i></a>
                            <a href="<%=  settings.instagram %>"><i class="icon-instagram"></i></a>
                            <a href="<%=  settings.linkedin %>"><i class="fab fa-linkedin"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="site-footer-two__bottom">
        <div class="container">
            <div class="site-footer-two__bottom-inner">
                <p class="site-footer-two__bottom-text">© Copywright 2026 Amber Accident Claims Management. All Rights
                    Reserved. Designed by <a href="#">HUBSOL</a></p>
            </div>
        </div>
    </div>
</footer>
<!--Site Footer Two End-->
</div>
