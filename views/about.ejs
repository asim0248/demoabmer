<%- include("partials/header/header.ejs") %>

    <div class="page-wrapper">
        <%- include("partials/menu/menu.ejs") %>

            <%- include("partials/breadcrump/breadcrump.ejs") %>

                <!--About Three Start-->
                <section class="about-three">
                    <div class="container">
                        <div class="row">
                            <div class="col-xl-6">
                                <div class="about-three__left wow slideInLeft" data-wow-delay="100ms"
                                    data-wow-duration="2500ms">
                                    <div class="about-three__img-box">
                                        <div class="about-three__img">
                                            <img src="<%= showPageAboutSection?.mainImage.url || ''  %>" alt="">
                                        </div>
                                        <div class="about-three__img-two">
                                            <img src="<%= showPageAboutSection?.secondImage.url || ''  %>" alt="">
                                        </div>
                                        <div class="about-three__video-and-experience-box">
                                            <div class="about-three__experience-box">
                                                <div class="about-three__experience-count">
                                                    <h3 class="odometer"
                                                        data-count="<%= showPageAboutSection.experienceYear %>">00</h3>
                                                    <span>+</span>
                                                </div>
                                                <p class="about-three__experience-count-text">
                                                    <%= showPageAboutSection.experienceText %>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-6">
                                <div class="about-three__right">
                                    <div class="section-title text-left sec-title-animation animation-style2">
                                        <div class="section-title__tagline-box">
                                            <div class="section-title__tagline-border">
                                                <div class="section-title__shape-1">
                                                    <i class="section-title__circle"></i>
                                                </div>
                                            </div>
                                            <h6 class="section-title__tagline">
                                                <%= showPageAboutSection.smallHeading %>
                                            </h6>
                                            <div class="section-title__tagline-border">
                                                <div class="section-title__shape-2">
                                                    <i class="section-title__circle"></i>
                                                </div>
                                            </div>
                                        </div>
                                        <h3 class="section-title__title title-animation"><%-
                                                showPageAboutSection.heading %>
                                        </h3>
                                    </div>
                                    <p class="about-three__text"><%- showPageAboutSection.description %></p>
                                    <div class="about-three__points-and-founder-box">
                                        <ul class="about-three__point-two">
                                            <% if(showPageAboutSection.features.length===0) { %>
                                                <p>No features Found</p>
                                                <% } else { %>
                                                    <% showPageAboutSection.features.forEach(abFeature=> { %>
                                                        <li>
                                                            <div class="icon">
                                                                <span class="fas fa-check"></span>
                                                            </div>
                                                            <div class="text">
                                                                <p><%= abFeature.title %></p>
                                                            </div>
                                                        </li>
                                                        <% }); %>
                                                            <% } %>
                                        </ul>
                                    </div>
                                    <div class="about-three__btn-and-review-box">
                                        <div class="about-three__review-box">
                                            <ul class="list-unstyled about-three__review-list">
                                                <li>
                                                    <div class="about-three__review-img">
                                                        <img src="/webassets/images/resources/about-two-review-img-1-1.jpg"
                                                            alt="">
                                                    </div>
                                                </li>
                                                <li>
                                                    <div class="about-three__review-img">
                                                        <img src="/webassets/images/resources/about-two-review-img-1-2.jpg"
                                                            alt="">
                                                    </div>
                                                </li>
                                                <li>
                                                    <div class="about-three__review-img">
                                                        <img src="/webassets/images/resources/about-two-review-img-1-3.jpg"
                                                            alt="">
                                                    </div>
                                                </li>
                                            </ul>
                                            <div class="about-three__review-star-and-text">
                                                <div class="about-three__review-star">
                                                    <span class="fas fa-star"></span>
                                                    <span class="fas fa-star"></span>
                                                    <span class="fas fa-star"></span>
                                                    <span class="fas fa-star"></span>
                                                    <span class="fas fa-star"></span>
                                                </div>
                                                <p class="about-three__review-text">Clients 4.8</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!--About Three End-->


                <!--Process One Start -->
                <section class="process-one">
                    <div class="process-one__bg-color"></div>
                    <div class="container">
                        <div class="section-title text-center sec-title-animation animation-style1">
                            <div class="section-title__tagline-box">
                                <div class="section-title__tagline-border">
                                    <div class="section-title__shape-1">
                                        <i class="section-title__circle"></i>
                                    </div>
                                </div>
                                <h6 class="section-title__tagline">Working Process</h6>
                                <div class="section-title__tagline-border">
                                    <div class="section-title__shape-2">
                                        <i class="section-title__circle"></i>
                                    </div>
                                </div>
                            </div>
                            <h3 class="section-title__title title-animation">How To Work <span>It</span>
                            </h3>
                        </div>
                        <div class="process-one__inner">
                            <div class="row">
                                <% if (abWorks.length===0) { %>
                                    <p>No How It Works Found</p>
                                    <% } else { %>
                                        <% abWorks.forEach(work=> { %>
                                            <!--Process One Single Start-->
                                            <div class="col-xl-3 col-lg-6 col-md-6 wow fadeInLeft"
                                                data-wow-delay="100ms">
                                                <div class="process-one__single">
                                                    <div class="process-one__single-inner">
                                                        <div class="process-one__icon">
                                                            <img src="<%= work.icon.url  %>" alt="">
                                                        </div>
                                                        <div class="process-one__single-inner-bg"
                                                            style="background-image: url(<%= work.backgroundImage.url %>);">
                                                        </div>
                                                        <div class="process-one__content">
                                                            <h3 class="process-one__title">
                                                                <%= work.title %>
                                                            </h3>
                                                            <p class="process-one__text">
                                                                <%= work.description %>
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="process-one__count"></div>
                                                </div>
                                            </div>
                                            <!--Process One Single End-->
                                            <% }); %>
                                                <% } %>
                            </div>
                        </div>
                    </div>
                </section>
                <!--Process One End -->

                <!--Why Choose Two Start-->
                <section class="why-choose-two">
                    <div class="container">
                        <div class="row">
                            <div class="col-xl-6">
                                <div class="why-choose-two__left">
                                    <div class="section-title text-left sec-title-animation animation-style2">
                                        <div class="section-title__tagline-box">
                                            <div class="section-title__tagline-border">
                                                <div class="section-title__shape-1">
                                                    <i class="section-title__circle"></i>
                                                </div>
                                            </div>
                                            <h6 class="section-title__tagline">
                                                <%= abWhyChooseUs.smallHeading %>
                                            </h6>
                                            <div class="section-title__tagline-border">
                                                <div class="section-title__shape-2">
                                                    <i class="section-title__circle"></i>
                                                </div>
                                            </div>
                                        </div>
                                        <h3 class="section-title__title title-animation"><%- abWhyChooseUs.heading %>
                                        </h3>
                                    </div>
                                    <p class="why-choose-two__text">
                                        <%= abWhyChooseUs.shortDescription %>
                                    </p>
                                    <ul class="why-choose-two__points">
                                        <% if(abWhyChooseUs.features.length===0) { %>
                                            <p>No features Found</p>
                                            <% } else { %>
                                                <% abWhyChooseUs.features.forEach(whyFeature=> { %>
                                                    <li>
                                                        <div class="icon">
                                                            <span class="<%= whyFeature.icon %>"></span>
                                                        </div>
                                                        <div class="content">
                                                            <h4>
                                                                <%= whyFeature.title %>
                                                            </h4>
                                                            <p>
                                                                <%= whyFeature.description %>
                                                            </p>
                                                        </div>
                                                    </li>
                                                    <% }); %>
                                                        <% } %>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-xl-6">
                                <div class="why-choose-two__right">
                                    <div class="why-choose-two__img-box">
                                        <div class="why-choose-two__img">
                                            <div class="before-after-twentytwenty" id="wrinkle-before-after">
                                                <img src="<%= abWhyChooseUs.beforeImage.url %>" alt="">
                                                <img src="<%= abWhyChooseUs.afterImage.url %>" alt="">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!--Why Choose Two End-->

                <%- include("partials/footer/footer2.ejs") %>