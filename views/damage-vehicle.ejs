    <%- include("partials/header/header.ejs") %>

    <div class="page-wrapper">
        <%- include("partials/menu/menu.ejs") %>

<%- include("partials/breadcrump/breadcrump.ejs") %>

        <!--Project Page Start-->
                <% if (pageDamageVehicle && pageDamageVehicle.length > 0) { %>
                    <section class="project-page">
                        <div class="container">
                            <div class="project-page__inner">
                                <div class="row">
                                    <!--Project Two Single Start-->
                                    <% pageDamageVehicle.forEach((pageDmgVehi)=> { %>
                                    <div class="col-xl-4 col-lg-4 col-md-6">
                                        <div class="project-two__single">
                                            <div class="project-two__img-box">
                                                <div class="project-two__img">
                                                    <img src="<%= pageDmgVehi.dmgImage.url %>" alt="<%= pageDmgVehi.altText %>">
                                                </div>
                                                <div class="project-two__content">
                                                    <div class="project-two__title-box">
                                                        <a href="<%= pageDmgVehi.dmgImage.url %>" class="img-popup"><span
                                                                class="fas fa-plus"></span></a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% }) %>
                                    <!--Project Two Single End-->
                                </div>
                            </div>
                        </div>
                    </section>
                <% } %>
        <!--Project Page End-->

        <%- include("partials/footer/footer2.ejs") %>