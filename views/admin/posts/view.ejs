<%- include("../partials/boilerplate.ejs") %>

    <%- include("../partials/header.ejs") %>

        <!-- Page header end-->
        <div class="page-body-wrapper">
            <!-- Page sidebar start-->
            <%- include("../partials/sidebar.ejs") %>
                <!-- Page sidebar end-->
                <div class="page-body">
                    <div class="container-fluid">
                        <div class="row page-title">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h3>Blog Posts</h3>
                                    <a href="/admin/blog/posts/add" class="btn m-1 btn-primary">Add New Post</a>
                                </div>

                            </div>
                        </div>
                    </div>
                    <!-- Container-fluid starts-->
                    <%- include("../partials/flash.ejs") %>
                        <%- include("../partials/model.ejs") %>
                            <div class="container-fluid edit-profile">
                                <div class="row">
                                    <div class="col-xl-12">
                                        <div class="card-body rolecard-body">
                                            <div class="table-responsive">
                                                <table class="display" id="basic-1">
                                                    <thead>
                                                        <tr>
                                                            <th>Title</th>
                                                            <th>Sort Order</th>
                                                            <th>Publish Type</th>
                                                            <th>Publish Date</th>
                                                            <th>Status</th>
                                                            <th>Is Featured</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% if (allBlogs.length===0) { %>
                                                            <% } else { %>
                                                                <% allBlogs.forEach((post)=> { %>
                                                                    <tr>
                                                                        <td>
                                                                            <%= post.blogTitle %>
                                                                        </td>
                                                                        <td>
                                                                            <%= post.sortOrder %>
                                                                        </td>
                                                                        <td>
                                                                            <% if(post.publishType==='Publish' ){ %>

                                                                                <span class="badge bg-success">
                                                                                    Published
                                                                                </span>

                                                                                <% } else { %>

                                                                                    <span
                                                                                        class="badge bg-warning text-dark">
                                                                                        Scheduled
                                                                                    </span>

                                                                                    <% } %>
                                                                        </td>
                                                                        <td>
                                                                            <% if(post.publishDate){ %>

                                                                                <%= new
                                                                                    Date(post.publishDate).toLocaleString()
                                                                                    %>

                                                                                    <% } else { %>

                                                                                        -

                                                                                        <% } %>
                                                                        </td>
                                                                        <td>
                                                                            <div class="flip-btn-wrap">
                                                                                <button
                                                                                    class="btn btn-sm status-btn <%= post.status === 'Active' ? '' : 'flipped' %>"
                                                                                    data-url="/admin/blog/posts/<%= post._id %>/toggle-status">
                                                                                    <span
                                                                                        class="flip-front">Active</span>
                                                                                    <span
                                                                                        class="flip-back">Inactive</span>
                                                                                </button>
                                                                            </div>
                                                                        </td>
                                                                        <td>
                                                                            <div class="flip-btn-wrap">
                                                                                <button
                                                                                    class="btn btn-sm featured-btn <%= post.isFeatured === 'Featured' ? '' : 'flipped' %>"
                                                                                    data-url="/admin/blog/posts/<%= post._id %>/toggle-featured">
                                                                                    <span
                                                                                        class="flip-front">Featured</span>
                                                                                    <span class="flip-back">Not
                                                                                        Featured</span>
                                                                                </button>
                                                                            </div>
                                                                        </td>
                                                                        <td>
                                                                            <ul class="action">
                                                                                <li class="edit"> <a title="Edit"
                                                                                        href="/admin/blog/posts/<%= post._id %>/edit"><i
                                                                                            class="fa-regular fa-pen-to-square"></i></a>
                                                                                </li>
                                                                                <li class="delete">
                                                                                    <button type="button"
                                                                                        data-url="/admin/blog/posts/<%= post._id %>?_method=DELETE"
                                                                                        class="delete-btn"
                                                                                        data-id="<%= post._id %>"
                                                                                        data-name="<%= post.name %>"
                                                                                        data-bs-toggle="modal"
                                                                                        data-bs-target="#deleteModel">
                                                                                        <i
                                                                                            class="fa-solid fa-trash"></i>
                                                                                    </button>

                                                                                </li>
                                                                            </ul>
                                                                        </td>
                                                                    </tr>
                                                                    <% }) %>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Container-fluid ends-->
                </div>

                <%- include("../partials/footer.ejs") %>