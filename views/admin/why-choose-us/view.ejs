<%- include("../partials/boilerplate.ejs") %>

    <%- include("../partials/header.ejs") %>

        <!-- Page header end-->
        <div class="page-body-wrapper">
            <!-- Page sidebar start-->
            <%- include("../partials/sidebar.ejs") %>
                <!-- Page sidebar end-->
                <div class="page-body">
                    <div class="container-fluid">
                        <div class="row page-title">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h3>Why Choose Us Section</h3>
                                </div>

                            </div>
                        </div>
                    </div>
                    <!-- Container-fluid starts-->
                    <%- include("../partials/flash.ejs") %>
                        <%- include("../partials/model.ejs") %>
                            <div class="container-fluid edit-profile">
                                <div class="row">
                                    <div class="col-xl-12">
                                        <div class="card-body rolecard-body">
                                            <div class="table-responsive">
                                                <table class="display" id="basic-1">
                                                    <thead>
                                                        <tr>
                                                            <th>Name</th>
                                                            <th>Status</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% if (!whyChooseUsSection) { %>

                                                            <tr>
                                                                <td colspan="5" class="text-center">
                                                                    No Why Choose Us Section Found
                                                                </td>
                                                            </tr>

                                                            <% } else { %>

                                                                <tr>

                                                                    <td>
                                                                        <%= whyChooseUsSection.heading %>
                                                                    </td>

                                                                    <td>
                                                                        <div class="flip-btn-wrap">
                                                                            <button
                                                                                class="btn btn-sm status-btn <%= whyChooseUsSection.status === 'Active' ? '' : 'flipped' %>"
                                                                                data-url="/admin/why-choose-us/toggle-status">
                                                                                <span class="flip-front">Active</span>
                                                                                <span class="flip-back">Inactive</span>
                                                                            </button>
                                                                        </div>
                                                                    </td>

                                                                    <td>
                                                                        <ul class="action">
                                                                            <li class="edit">
                                                                                <a href="/admin/why-choose-us/edit">
                                                                                    <i
                                                                                        class="fa-regular fa-pen-to-square"></i>
                                                                                </a>
                                                                            </li>
                                                                        </ul>
                                                                    </td>
                                                                </tr>

                                                                <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Container-fluid ends-->
                </div>

                <%- include("../partials/footer.ejs") %>