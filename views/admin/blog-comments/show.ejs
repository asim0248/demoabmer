<%- include("../partials/boilerplate.ejs") %>

    <%- include("../partials/header.ejs") %>

        <!-- Page header end-->
        <div class="page-body-wrapper">
            <!-- Page sidebar start-->
            <%- include("../partials/sidebar.ejs") %>
                <div class="page-body">
                    <div class="container-fluid">
                        <div class="row page-title">
                            <div class="col-sm-12">
                                <h3>Blog Comment: <%= showBlogComment.post.blogTitle %>
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="container-fluid edit-profile">
                        <div class="row">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="mb-3">
                                        <label class="form-label">User Name</label>
                                        <input class="form-control" readonly name="name" value="<%= showBlogComment.name %>"
                                            type="text">
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="mb-3">
                                        <label class="form-label">Email</label>
                                        <input class="form-control" name="email" readonly value="<%= showBlogComment.email %>"
                                            type="text">
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="mb-3">
                                        <label class="form-label">Comment</label>
                                        <textarea class="form-control" readonly name="comment">
                                            <%= showBlogComment.comment %>
                                        </textarea>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="mb-3">
                                        <label class="form-label">Blog Title</label>
                                        <input class="form-control" readonly value="<%= showBlogComment.post.blogTitle %>"
                                            type="text">
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="mb-3">
                                        <label class="form-label">Comment Submitted At</label>
                                        <input class="form-control" readonly value="<%= new
                                                                        Date(showBlogComment.createdAt).toLocaleString('en-GB',
                                                                        { day: '2-digit' , month: 'long' ,
                                                                        year: 'numeric' , hour: '2-digit' ,
                                                                        minute: '2-digit' , hour12: true
                                                                        }).replace(',', ' at' )%>"
                                            type="text">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer text-end">
                            <a href="/admin/blog/blog-comments/" class="btn btn-primary">Back</a>
                        </div>
                        </form>
                    </div>
                </div>
        </div>
        </div>

        <%- include("../partials/footer.ejs") %>