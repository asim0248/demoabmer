              <script>
                $('#publishType').change(function () {

                  if ($(this).val() == 'Schedule') {
                    $('#scheduleBox').slideDown();
                  } else {
                    $('#scheduleBox').slideUp();
                  }

                });

                $('#publishType').trigger('change');
              </script>
              <script>
                function toggleSchedule() {

                  if ($('#publishType').val() == 'Schedule') {

                    $('#scheduleBox').show();

                  } else {

                    $('#scheduleBox').hide();

                  }

                }

                toggleSchedule();

                $('#publishType').change(toggleSchedule);
              </script>
