<%- include("../partials/boilerplate.ejs") %>

    <%- include("../partials/header.ejs") %>

        <!-- Page header end-->
        <div class="page-body-wrapper">
            <!-- Page sidebar start-->
            <%- include("../partials/sidebar.ejs") %>
                <!-- Page sidebar end-->
                <div class="page-body">
                    <div class="container-fluid">
                        <div class="row page-title">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h3>Newsletter</h3>
                                    <a href="/admin/newsletter/export-csv">Export CSV</a>
                                </div>

                            </div>
                        </div>
                    </div>
                    <!-- Container-fluid starts-->
                    <%- include("../partials/flash.ejs") %>
                        <%- include("../partials/model.ejs") %>
                            <div class="container-fluid edit-profile">
                                <div class="row">
                                    <div class="col-xl-12">
                                        <div class="card-body rolecard-body">
                                            <div class="table-responsive">
                                                <table class="display" id="basic-1">
                                                    <thead>
                                                        <tr>
                                                            <th>#</th>
                                                            <th>Email</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <% if (allEmails.length===0) { %>
                                                            <% } else { %>
                                                                <% allEmails.forEach((subscriber, index)=> { %>
                                                                    <tr>
                                                                        <td>
                                                                            <%= index + 1 %>
                                                                        </td>
                                                                        <td>
                                                                            <%= subscriber.email  %>
                                                                        </td>
                                                                        <td>
                                                                            <ul class="action">
                                                                                <li class="delete">
                                                                                    <button type="button"
                                                                                        data-url="/admin/newsletter/<%= subscriber._id %>?_method=DELETE"
                                                                                        class="delete-btn"
                                                                                        data-id="<%= subscriber._id %>"
                                                                                        data-name="<%= subscriber.name %>"
                                                                                        data-bs-toggle="modal"
                                                                                        data-bs-target="#deleteModel">
                                                                                        <i
                                                                                            class="fa-solid fa-trash"></i>
                                                                                    </button>

                                                                                </li>
                                                                            </ul>
                                                                        </td>
                                                                    </tr>
                                                                    <% }) %>
                                                                        <% } %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Container-fluid ends-->
                </div>

                <%- include("../partials/footer.ejs") %>