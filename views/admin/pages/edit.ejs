<%- include("../partials/boilerplate.ejs") %>

    <%- include("../partials/header.ejs") %>

        <!-- Page header end-->
        <div class="page-body-wrapper">
            <!-- Page sidebar start-->
            <%- include("../partials/sidebar.ejs") %>
                <!-- Page sidebar end-->
                <div class="page-body">
                    <div class="container-fluid">
                        <div class="row page-title">
                            <div class="col-sm-12">
                                <h3>Edit Page</h3>
                            </div>
                        </div>
                    </div>
                    <%- include("../partials/flash.ejs") %>
                        <!-- Container-fluid starts-->
                        <div class="container-fluid edit-profile">
                            <div class="row">
                                <div class="col-xl-12">
                                    <form class="card" method="POST"
                                        action="/admin/pages/<%= singlePage._id %>?_method=PUT">
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Page Name<span
                                                                style="color: red;">*</span></label>
                                                        <input class="form-control" name="pageName"
                                                            value="<%= singlePage.pageName %>" id="pageName"
                                                            type="text">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">slug<span
                                                                style="color: red;">*</span></label>
                                                        <input class="form-control" name="slug"
                                                            value="<%= singlePage.slug %>" id="slug" type="text">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Menu Order</label>
                                                        <input class="form-control" value="<%= singlePage.menuOrder %>"
                                                            name="menuOrder" type="number">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Section Heading</label>
                                                        <input class="form-control" value="<%= singlePage.sectionHeading %>" name="sectionHeading" type="text">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Section Tag Line</label>
                                                        <input class="form-control" value="<%= singlePage.sectionTagLine %>" name="sectionTagLine" type="text">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Meta Title</label>
                                                        <input class="form-control" name="metaTitle"
                                                            value="<%= singlePage.metaTitle %>" type="text">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Meta Keywords</label>
                                                        <input class="form-control" name="metaKeywords"
                                                            value="<%= singlePage.metaKeywords %>" type="text">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Meta Description</label>
                                                        <textarea class="form-control"
                                                            value="<%= singlePage.metaDescription %>"
                                                            name="metaDescription" id=""></textarea>
                                                    </div>
                                                </div>
                                                <div class="col-sm-12">
                                                    <label class="form-label">Detail Content</label>
                                                    <textarea id="content"
                                                        name="pageContent"><%= singlePage.pageContent %></textarea>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-footer text-end">
                                            <button class="btn btn-primary" type="submit">Update Page</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <!-- Container-fluid ends-->
                </div>

                <%- include("../partials/footer.ejs") %>