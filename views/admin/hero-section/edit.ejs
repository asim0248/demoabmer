<%- include("../partials/boilerplate.ejs") %>

    <%- include("../partials/header.ejs") %>

        <!-- Page header end-->
        <div class="page-body-wrapper">
            <!-- Page sidebar start-->
            <%- include("../partials/sidebar.ejs") %>
                <!-- Page sidebar end-->
                <div class="page-body">
                    <div class="container-fluid">
                        <div class="row page-title">
                            <div class="col-sm-12">
                                <h3>Edit Slide</h3>
                            </div>
                        </div>
                    </div>
                    <%- include("../partials/flash.ejs") %>
                        <!-- Container-fluid starts-->
                        <div class="container-fluid edit-profile">
                            <div class="row">
                                <div class="col-xl-12">
                                    <form class="card" method="POST"
                                        action="/admin/hero-section/<%= heroSection._id %>?_method=PUT"
                                        enctype="multipart/form-data">
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Tag Line</label>
                                                        <input class="form-control" name="tagLine" type="text"
                                                            value="<%= heroSection.tagLine %>">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Heading</label>
                                                        <input class="form-control" name="heading" type="text"
                                                            value="<%= heroSection.heading %>">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Sort Order</label>
                                                        <input class="form-control" name="sortOrder" type="number"
                                                            value="<%= heroSection.sortOrder %>">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Short Para Text</label>
                                                        <textarea name="paraText" id=""
                                                            class="form-control"><%= heroSection.paraText %></textarea>
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Button Text</label>
                                                        <input class="form-control" name="buttonText" type="text"
                                                            value="<%= heroSection.buttonText %>">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Button Url</label>
                                                        <input class="form-control" name="buttonLink" type="url"
                                                            value="<%= heroSection.buttonLink %>">
                                                    </div>
                                                </div>
                                                <div class="col-lg-12">
                                                    <div class="mb-3">
                                                        <label class="form-label">Banner Image</label>
                                                        <input class="form-control" name="sldImage" type="file">
                                                        <img style="width: 300px; height: 150px; border-radius: 5px; margin-top: 15px;" src="<%= heroSection.sldImage.url %>" alt="img">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="card-footer text-end">
                                            <button class="btn btn-primary" type="submit">Update Slide</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <!-- Container-fluid ends-->
                </div>

                <%- include("../partials/footer.ejs") %>